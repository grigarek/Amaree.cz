{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "amaree-development",
  "main": "./custom-worker.ts",
  "compatibility_date": "2026-07-17",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "vars": {
    "DEPLOY_TARGET": "cloudflare",
    "APP_ENV": "development",
    "NEXT_PUBLIC_APP_ENV": "development",
    "SUPABASE_ENVIRONMENT": "development",
    "ALLOW_LOCAL_ADMIN": "false",
    "GOPAY_ENVIRONMENT": "sandbox",
    "GOPAY_CHECKOUT_ENABLED": "false",
    "PACKETA_ENVIRONMENT": "test",
    "PACKETA_API_ENABLED": "false",
    "TRANSACTIONAL_EMAIL_PROVIDER": "resend",
    "TRANSACTIONAL_EMAIL_SEND_ENABLED": "false",
    "TRANSACTIONAL_EMAIL_DAILY_WARNING_LIMIT": "80",
    "TRANSACTIONAL_EMAIL_MONTHLY_WARNING_LIMIT": "2400",
    "RESEND_FROM_EMAIL": "AMARÉE <objednavky@notify.amaree.cz>",
    "TRANSACTIONAL_EMAIL_REPLY_TO": "info@amaree.cz",
    "ECOMAIL_NEWSLETTER_ENABLED": "false",
    "FAKTUROID_ACCOUNT_SLUG": "medianum",
    "FAKTUROID_API_ENABLED": "false",
    "AI_PRODUCT_ASSISTANT_ENABLED": "false",
    "OPENAI_PRODUCT_ASSISTANT_MODEL": "gpt-5-mini"
  },
  "env": {
    "staging": {
      "name": "amaree-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "amaree.cz", "custom_domain": true },
        { "pattern": "www.amaree.cz", "custom_domain": true }
      ],
      "vars": {
        "DEPLOY_TARGET": "cloudflare",
        "APP_ENV": "production",
        "NEXT_PUBLIC_APP_ENV": "production",
        "NEXT_PUBLIC_SITE_URL": "https://amaree.cz",
        "CLOUDFLARE_ACCOUNT_ID": "145415cdbb5d69fc6597087342439638",
        "CLOUDFLARE_ZONE_ID": "f45a71841b2f6bce59c7209a22ee52ea",
        "SUPABASE_ENVIRONMENT": "production",
        "ALLOW_LOCAL_ADMIN": "false",
        "GOPAY_ENVIRONMENT": "production",
        "GOPAY_CHECKOUT_ENABLED": "true",
        "PACKETA_ENVIRONMENT": "production",
        "PACKETA_API_ENABLED": "true",
        "PACKETA_VALIDATION_MODE": "remote",
        "TRANSACTIONAL_EMAIL_PROVIDER": "resend",
        "TRANSACTIONAL_EMAIL_SEND_ENABLED": "true",
        "TRANSACTIONAL_EMAIL_DAILY_WARNING_LIMIT": "80",
        "TRANSACTIONAL_EMAIL_MONTHLY_WARNING_LIMIT": "2400",
        "RESEND_FROM_EMAIL": "AMARÉE <objednavky@notify.amaree.cz>",
        "TRANSACTIONAL_EMAIL_REPLY_TO": "info@amaree.cz",
        "ECOMAIL_NEWSLETTER_ENABLED": "true",
        "ECOMAIL_LIST_ID": "1",
        "FAKTUROID_ACCOUNT_SLUG": "medianum",
        "FAKTUROID_API_ENABLED": "true",
        "AI_PRODUCT_ASSISTANT_ENABLED": "true",
        "OPENAI_PRODUCT_ASSISTANT_MODEL": "gpt-5-mini"
      },
      "triggers": {
        "crons": ["0 * * * *"]
      }
    },
    "production": {
      "name": "amaree-production",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "DEPLOY_TARGET": "cloudflare",
        "APP_ENV": "production",
        "NEXT_PUBLIC_APP_ENV": "production",
        "NEXT_PUBLIC_SITE_URL": "https://amaree.cz",
        "SUPABASE_ENVIRONMENT": "production",
        "ALLOW_LOCAL_ADMIN": "false",
        "GOPAY_ENVIRONMENT": "production",
        "GOPAY_CHECKOUT_ENABLED": "false",
        "PACKETA_ENVIRONMENT": "production",
        "PACKETA_API_ENABLED": "false",
        "TRANSACTIONAL_EMAIL_PROVIDER": "resend",
        "TRANSACTIONAL_EMAIL_SEND_ENABLED": "false",
        "TRANSACTIONAL_EMAIL_DAILY_WARNING_LIMIT": "80",
        "TRANSACTIONAL_EMAIL_MONTHLY_WARNING_LIMIT": "2400",
        "RESEND_FROM_EMAIL": "AMARÉE <objednavky@notify.amaree.cz>",
        "TRANSACTIONAL_EMAIL_REPLY_TO": "info@amaree.cz",
        "ECOMAIL_NEWSLETTER_ENABLED": "false",
        "FAKTUROID_ACCOUNT_SLUG": "medianum",
        "FAKTUROID_API_ENABLED": "false",
        "AI_PRODUCT_ASSISTANT_ENABLED": "false",
        "OPENAI_PRODUCT_ASSISTANT_MODEL": "gpt-5-mini"
      },
      "triggers": {
        "crons": ["0 * * * *"]
      }
    }
  }
}
