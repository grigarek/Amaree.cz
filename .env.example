NEXT_PUBLIC_SITE_URL=http://localhost:3000
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ANALYTICS_API_TOKEN=
APP_ENV=development
NEXT_PUBLIC_APP_ENV=development
SUPABASE_ENVIRONMENT=development
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Packeta Widget API key is a public widget identifier. Never expose the API password.
NEXT_PUBLIC_PACKETA_WIDGET_API_KEY=
PACKETA_VALIDATION_MODE=mock
PACKETA_ENVIRONMENT=test
PACKETA_API_ENABLED=false
CRON_SECRET=
PACKETA_API_PASSWORD=
PACKETA_SENDER=
PACKETA_DEFAULT_WEIGHT_KG=0.5
PACKETA_HOME_CARRIER_ID_CZ=
PACKETA_HOME_CARRIER_ID_SK=

# GoPay remains disabled until sandbox credentials are provided and reviewed.
GOPAY_ENVIRONMENT=sandbox
GOPAY_GO_ID=
GOPAY_CLIENT_ID=
GOPAY_CLIENT_SECRET=
GOPAY_CHECKOUT_ENABLED=false
NEXT_PUBLIC_GOPAY_ENABLED_METHODS=

# Transactional e-mail. The API key is server-only and belongs in .env.local or Cloudflare Secrets.
TRANSACTIONAL_EMAIL_PROVIDER=resend
TRANSACTIONAL_EMAIL_SEND_ENABLED=false
TRANSACTIONAL_EMAIL_TEST_RECIPIENT=
TRANSACTIONAL_EMAIL_DAILY_WARNING_LIMIT=80
TRANSACTIONAL_EMAIL_MONTHLY_WARNING_LIMIT=2400
RESEND_API_KEY=
RESEND_FROM_EMAIL="AMARÉE <objednavky@notify.amaree.cz>"
TRANSACTIONAL_EMAIL_REPLY_TO=info@amaree.cz

# Future optional newsletter integration. It is not used for order or status e-mails.
ECOMAIL_NEWSLETTER_ENABLED=false
ECOMAIL_API_KEY=
ECOMAIL_LIST_ID=

# Optional product-content assistant. Keep disabled until API billing and a project budget are configured.
AI_PRODUCT_ASSISTANT_ENABLED=false
OPENAI_PRODUCT_ASSISTANT_MODEL=gpt-5-mini
OPENAI_API_KEY=

# Fakturoid is disabled until the account and a test invoice are reviewed.
FAKTUROID_API_ENABLED=false
FAKTUROID_ACCOUNT_SLUG=
FAKTUROID_CLIENT_ID=
FAKTUROID_CLIENT_SECRET=

# Local admin bypass is allowed only in NODE_ENV=development and must be explicit.
ALLOW_LOCAL_ADMIN=false
